APP_ENV=development

POSTGRES_DB=sdr_imobiliario
POSTGRES_USER=sdr
POSTGRES_PASSWORD=sdr
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://sdr:sdr@postgres:5432/sdr_imobiliario

BACKEND_PORT=8000
FRONTEND_PORT=3000

# LLM local no host Windows (llama.cpp / llama-server)
# O alias deve corresponder ao nome exposto pelo servidor OpenAI-compatible.
LLM_BASE_URL=http://host.docker.internal:8080
LLM_MODEL=local-model
LLM_TIMEOUT=30
